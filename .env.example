# --- API Configuration ---
# Public API URL for client-side fetching (e.g., https://api.yourdomain.com/api)
NEXT_PUBLIC_API_URL="http://localhost:5000/api"

# Internal API URL for SSR (e.g., http://server:5000)
# This is optional and rarely used unless you have a specific docker networking setup.
INTERNAL_API_URL="http://localhost:5000"

# --- Security & Captcha ---
# Cloudflare Turnstile Site Key (Public)
NEXT_PUBLIC_TURNSTILE_SITE="1x00000000000000000000AA"